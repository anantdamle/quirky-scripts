#!/usr/bin/env bash
# ==============================================================================
# Command:     git-stack
# Description: Local-only branch stacking for Git, in the spirit of gh-stack /
#              Graphite, but with zero GitHub involvement. Each branch records
#              its parent branch in the repository's own .git/config, so a
#              "stack" is simply a chain (or tree) of parent pointers rooted at
#              the trunk. Changes to a lower branch are propagated upwards with
#              `git rebase --onto`, keeping history linear.
#
#              Tracking data lives in .git/config as:
#                  [branch "<name>"]
#                      stackparent = <parent branch>
#                      stackbase   = <parent commit last restacked onto>
#              It is therefore per-clone, invisible to the remote, and removed
#              automatically when you delete the branch config.
#
# Usage:       git stack create <name>          Branch off HEAD, record parent
#              git stack track <parent>         Adopt current branch into a stack
#              git stack untrack [branch]       Drop tracking, relink children
#              git stack reparent <new-parent>  Insert a new branch beneath the
#                                               current stack and restack it
#              git stack list                   Show the stack tree
#              git stack status                 Tree + sync state per branch
#              git stack sync [--pull]          Restack the current stack
#              git stack up / down              Move one branch up / down
#              git stack top / bottom           Jump to the ends of the stack
#              git stack checkout               Interactive pick from the stack
#              git stack push [--dry-run]       Push every branch in the stack
#
# Config:      stack.trunk   Override trunk detection (default: origin/HEAD,
#                            then main / master / trunk)
# ==============================================================================

set -eu

PROGRAM="git stack"

# ------------------------------------------------------------------------------
# Output helpers
# ------------------------------------------------------------------------------

if [ -t 1 ]; then
    C_RESET=$'\033[0m'; C_BOLD=$'\033[1m'; C_DIM=$'\033[2m'
    C_RED=$'\033[31m'; C_GREEN=$'\033[32m'; C_YELLOW=$'\033[33m'; C_CYAN=$'\033[36m'
else
    C_RESET=''; C_BOLD=''; C_DIM=''; C_RED=''; C_GREEN=''; C_YELLOW=''; C_CYAN=''
fi

die() { printf '%sfatal:%s %s\n' "$C_RED" "$C_RESET" "$*" >&2; exit 1; }
info() { printf '%s%s%s\n' "$C_DIM" "$*" "$C_RESET"; }
note() { printf '%s\n' "$*"; }

# ------------------------------------------------------------------------------
# Repository / branch primitives
# ------------------------------------------------------------------------------

require_repo() {
    git rev-parse --git-dir >/dev/null 2>&1 || die "not a git repository"
}

current_branch() {
    branch=$(git branch --show-current)
    [ -n "$branch" ] || die "HEAD is detached; check out a branch first"
    printf '%s\n' "$branch"
}

branch_exists() {
    git show-ref --verify --quiet "refs/heads/$1"
}

# Trunk detection: explicit config wins, then origin/HEAD, then conventions.
trunk_branch() {
    configured=$(git config --get stack.trunk || true)
    if [ -n "$configured" ]; then
        branch_exists "$configured" || die "stack.trunk is set to '$configured', which does not exist"
        printf '%s\n' "$configured"
        return
    fi

    head_ref=$(git symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null || true)
    if [ -n "$head_ref" ]; then
        candidate=${head_ref#origin/}
        if branch_exists "$candidate"; then
            printf '%s\n' "$candidate"
            return
        fi
    fi

    for candidate in main master trunk; do
        if branch_exists "$candidate"; then
            printf '%s\n' "$candidate"
            return
        fi
    done

    die "could not detect trunk; set it with: git config stack.trunk <branch>"
}

# ------------------------------------------------------------------------------
# Stack metadata (.git/config)
# ------------------------------------------------------------------------------

parent_of() {
    git config --get "branch.$1.stackparent" 2>/dev/null || true
}

set_parent() {
    git config "branch.$1.stackparent" "$2"
}

clear_parent() {
    git config --unset "branch.$1.stackparent" 2>/dev/null || true
    git config --unset "branch.$1.stackbase" 2>/dev/null || true
}

# The parent commit this branch was last built on. Knowing this is what lets us
# replay only the branch's own commits, even if the parent was amended or
# rebased by hand long before '$PROGRAM sync' ran. Falls back to the merge base
# for branches adopted without one.
base_of() {
    local recorded
    recorded=$(git config --get "branch.$1.stackbase" 2>/dev/null || true)
    if [ -n "$recorded" ] && git cat-file -e "$recorded^{commit}" 2>/dev/null; then
        printf '%s\n' "$recorded"
    else
        git merge-base "$1" "$2"
    fi
}

set_base() {
    git config "branch.$1.stackbase" "$(git rev-parse "$2")"
}

# Direct children of $1, in alphabetical order.
children_of() {
    local key value child
    git config --get-regexp '^branch\..*\.stackparent$' 2>/dev/null |
        while read -r key value; do
            [ "$value" = "$1" ] || continue
            child=${key#branch.}
            child=${child%.stackparent}
            branch_exists "$child" || continue
            printf '%s\n' "$child"
        done | LC_ALL=C sort
}

# Walk parent pointers upwards from $1. A branch belongs to a stack only if it
# has a recorded parent, so we stop as soon as the parent is the trunk, missing,
# or itself untracked. Prints the topmost tracked branch: the stack's root.
stack_root() {
    local branch trunk parent
    branch=$1
    trunk=$2
    while :; do
        parent=$(parent_of "$branch")
        [ -n "$parent" ] || break
        [ "$parent" = "$trunk" ] && break
        branch_exists "$parent" || break
        [ -n "$(parent_of "$parent")" ] || break
        branch=$parent
    done
    printf '%s\n' "$branch"
}

# Every branch in the subtree rooted at $1, parents before children.
subtree() {
    local kids child
    printf '%s\n' "$1"
    kids=$(children_of "$1")
    for child in $kids; do
        subtree "$child"
    done
}

# Every branch in the same stack as $1, bottom-first.
stack_members() {
    root=$(stack_root "$1" "$2")
    subtree "$root"
}

guard_no_cycle() {
    # Refuse to make $2 the parent of $1 if $1 already sits below $2.
    child=$1
    candidate=$2
    walk=$candidate
    while [ -n "$walk" ]; do
        [ "$walk" = "$child" ] && die "'$candidate' is already stacked on '$child'; that would create a cycle"
        walk=$(parent_of "$walk")
    done
}

# ------------------------------------------------------------------------------
# Worktree safety: auto-stash and restore the starting branch
# ------------------------------------------------------------------------------

STASHED=0
START_BRANCH=''

restore_worktree() {
    if [ -n "$START_BRANCH" ] && [ "$(git branch --show-current)" != "$START_BRANCH" ]; then
        git checkout --quiet "$START_BRANCH" 2>/dev/null || true
    fi
    if [ "$STASHED" -eq 1 ]; then
        STASHED=0
        info "restoring stashed changes"
        git stash pop --quiet >/dev/null || note "${C_YELLOW}stash pop failed; your changes are still in 'git stash list'${C_RESET}"
    fi
}

begin_mutation() {
    START_BRANCH=$(current_branch)
    trap restore_worktree EXIT INT TERM
    if [ -n "$(git status --porcelain)" ]; then
        info "stashing local changes"
        git stash push --include-untracked --quiet --message "git-stack: autostash"
        STASHED=1
    fi
}

# ------------------------------------------------------------------------------
# Restacking
# ------------------------------------------------------------------------------

# restack_subtree <branch>
#
# The parent of <branch> is already in its final position. Everything in
# <branch> after its recorded base is replayed onto the parent's current tip,
# the new base is recorded, and the same is done for each child.
restack_subtree() {
    local branch parent new_base old_base kids child
    branch=$1
    parent=$(parent_of "$branch")
    new_base=$(git rev-parse "$parent")
    old_base=$(base_of "$branch" "$parent")

    if [ "$old_base" = "$new_base" ] && git merge-base --is-ancestor "$new_base" "$branch"; then
        info "  $branch is already up to date on $parent"
    else
        note "  restacking ${C_CYAN}$branch${C_RESET} onto ${C_CYAN}$parent${C_RESET}"
        if ! git rebase --onto "$parent" "$old_base" "$branch" >/dev/null; then
            note "${C_RED}rebase of '$branch' stopped with conflicts.${C_RESET}"
            note "Resolve them, run 'git rebase --continue', then re-run '$PROGRAM sync'."
            note "To back out entirely: git rebase --abort"
            if [ "$STASHED" -eq 1 ]; then
                note "${C_YELLOW}your local changes are parked in the stash; 'git stash pop' once the stack is clean${C_RESET}"
            fi
            trap - EXIT INT TERM   # leave the rebase in place for the user
            exit 1
        fi
    fi
    set_base "$branch" "$parent"

    # Not a pipeline: a conflicting rebase deeper in the tree must be able to
    # abort the whole script.
    kids=$(children_of "$branch")
    for child in $kids; do
        restack_subtree "$child"
    done
}

# ------------------------------------------------------------------------------
# Status rendering
# ------------------------------------------------------------------------------

sync_state() {
    local branch parent
    branch=$1
    parent=$2
    if [ "$(base_of "$branch" "$parent")" = "$(git rev-parse "$parent")" ] &&
       git merge-base --is-ancestor "$parent" "$branch"; then
        printf '%sin sync%s' "$C_GREEN" "$C_RESET"
    else
        printf '%sneeds restack%s' "$C_YELLOW" "$C_RESET"
    fi
}

remote_state() {
    branch=$1
    upstream=$(git rev-parse --abbrev-ref --symbolic-full-name "$branch@{upstream}" 2>/dev/null || true)
    if [ -z "$upstream" ]; then
        printf '%sno upstream%s' "$C_DIM" "$C_RESET"
        return
    fi
    counts=$(git rev-list --left-right --count "$branch...$upstream" 2>/dev/null || printf '0\t0')
    ahead=$(printf '%s' "$counts" | cut -f1)
    behind=$(printf '%s' "$counts" | cut -f2)
    if [ "$ahead" = 0 ] && [ "$behind" = 0 ]; then
        printf '%s= %s%s' "$C_DIM" "$upstream" "$C_RESET"
    else
        printf '%s+%s/-%s vs %s%s' "$C_DIM" "$ahead" "$behind" "$upstream" "$C_RESET"
    fi
}

# print_tree <branch> <indent> <current> <verbose>
print_tree() {
    local branch indent current verbose parent marker line kids child
    branch=$1
    indent=$2
    current=$3
    verbose=$4
    parent=$(parent_of "$branch")

    marker='  '
    [ "$branch" = "$current" ] && marker="${C_BOLD}* ${C_RESET}"

    line="${indent}${marker}${C_BOLD}${branch}${C_RESET}"
    if [ "$verbose" -eq 1 ] && [ -n "$parent" ]; then
        line="$line  [$(sync_state "$branch" "$parent")]  $(remote_state "$branch")"
    fi
    printf '%s\n' "$line"

    kids=$(children_of "$branch")
    for child in $kids; do
        print_tree "$child" "$indent  " "$current" "$verbose"
    done
}

# ------------------------------------------------------------------------------
# Subcommands
# ------------------------------------------------------------------------------

cmd_create() {
    [ $# -eq 1 ] || die "usage: $PROGRAM create <name>"
    name=$1
    branch_exists "$name" && die "branch '$name' already exists"
    parent=$(current_branch)
    git checkout -b "$name" >/dev/null
    set_parent "$name" "$parent"
    set_base "$name" "$parent"
    note "created ${C_CYAN}$name${C_RESET} stacked on ${C_CYAN}$parent${C_RESET}"
}

cmd_track() {
    [ $# -eq 1 ] || die "usage: $PROGRAM track <parent>"
    parent=$1
    branch_exists "$parent" || die "branch '$parent' does not exist"
    branch=$(current_branch)
    [ "$branch" = "$parent" ] && die "a branch cannot be its own parent"
    guard_no_cycle "$branch" "$parent"
    set_parent "$branch" "$parent"
    git config "branch.$branch.stackbase" "$(git merge-base "$branch" "$parent")"
    note "tracking ${C_CYAN}$branch${C_RESET} on top of ${C_CYAN}$parent${C_RESET}"
}

cmd_untrack() {
    if [ $# -eq 0 ]; then
        branch=$(current_branch)
    elif [ $# -eq 1 ]; then
        branch=$1
    else
        die "usage: $PROGRAM untrack [branch]"
    fi

    parent=$(parent_of "$branch")
    [ -n "$parent" ] || die "'$branch' is not tracked in a stack"

    kids=$(children_of "$branch")
    for child in $kids; do
        set_parent "$child" "$parent"
        git config "branch.$child.stackbase" "$(git merge-base "$child" "$parent")"
        note "relinked ${C_CYAN}$child${C_RESET} onto ${C_CYAN}$parent${C_RESET}"
    done

    clear_parent "$branch"
    note "untracked ${C_CYAN}$branch${C_RESET}"
    note "${C_DIM}run '$PROGRAM sync' to rebase the relinked branches${C_RESET}"
}

# Slot a new branch in underneath the current stack: the stack's bottom branch
# is re-pointed at <new-parent>, and the whole stack above it is restacked.
cmd_reparent() {
    [ $# -eq 1 ] || die "usage: $PROGRAM reparent <new-parent>"
    new_parent=$1
    branch_exists "$new_parent" || die "branch '$new_parent' does not exist"

    trunk=$(trunk_branch)
    branch=$(current_branch)
    bottom=$(stack_root "$branch" "$trunk")
    old_parent=$(parent_of "$bottom")
    [ -n "$old_parent" ] || die "'$bottom' is not tracked; run '$PROGRAM track <parent>' first"
    [ "$bottom" = "$new_parent" ] && die "'$new_parent' is the bottom of this stack"
    [ "$old_parent" = "$new_parent" ] && die "'$bottom' is already stacked on '$new_parent'"
    guard_no_cycle "$bottom" "$new_parent"

    note "re-pointing ${C_CYAN}$bottom${C_RESET} from ${C_CYAN}$old_parent${C_RESET} to ${C_CYAN}$new_parent${C_RESET}"
    set_parent "$bottom" "$new_parent"

    begin_mutation
    restack_subtree "$bottom"
    note "${C_GREEN}stack restacked on $new_parent${C_RESET}"
}

cmd_list() {
    verbose=${1:-0}
    trunk=$(trunk_branch)
    current=$(current_branch)

    # An untracked branch is not itself a stack member: it is a base. Show the
    # stacks sitting on top of it, if any.
    if [ -z "$(parent_of "$current")" ]; then
        kids=$(children_of "$current")
        if [ -z "$kids" ]; then
            note "${C_DIM}'$current' is not part of a stack. Start one with:${C_RESET}"
            note "${C_DIM}  $PROGRAM create <name>      # new branch on top of this one${C_RESET}"
            note "${C_DIM}  $PROGRAM track <parent>     # adopt this branch into a stack${C_RESET}"
            return
        fi
        printf '%s%s%s %s(base, checked out)%s\n' "$C_BOLD" "$current" "$C_RESET" "$C_DIM" "$C_RESET"
        for child in $kids; do
            print_tree "$child" '' "$current" "$verbose"
        done
        return
    fi

    root=$(stack_root "$current" "$trunk")
    base=$(parent_of "$root")
    [ -n "$base" ] || base=$trunk

    printf '%s%s%s %s(base)%s\n' "$C_DIM" "$base" "$C_RESET" "$C_DIM" "$C_RESET"
    print_tree "$root" '' "$current" "$verbose"
}

cmd_sync() {
    pull=0
    for arg in "$@"; do
        case $arg in
            --pull) pull=1 ;;
            *) die "usage: $PROGRAM sync [--pull]" ;;
        esac
    done

    trunk=$(trunk_branch)
    branch=$(current_branch)
    root=$(stack_root "$branch" "$trunk")
    [ -n "$(parent_of "$root")" ] || die "'$branch' is not part of a stack"

    base=$(parent_of "$root")

    begin_mutation

    if [ "$pull" -eq 1 ]; then
        info "fetching and fast-forwarding $base"
        git fetch --quiet
        upstream=$(git rev-parse --abbrev-ref --symbolic-full-name "$base@{upstream}" 2>/dev/null || true)
        if [ -n "$upstream" ]; then
            git checkout --quiet "$base"
            git merge --ff-only --quiet "$upstream" || die "'$base' cannot be fast-forwarded to $upstream"
        else
            info "  $base has no upstream; skipping"
        fi
    fi

    note "syncing stack rooted at ${C_CYAN}$root${C_RESET} (base: $base)"
    restack_subtree "$root"
    note "${C_GREEN}stack is in sync${C_RESET}"
}

cmd_up() {
    trunk=$(trunk_branch)
    branch=$(current_branch)
    kids=$(children_of "$branch")
    count=$(printf '%s' "$kids" | grep -c . || true)
    [ "$count" -eq 0 ] && die "'$branch' is at the top of the stack"
    if [ "$count" -gt 1 ]; then
        note "'$branch' has several branches stacked on it:"
        printf '%s\n' "$kids" | sed 's/^/  /'
        die "check one out explicitly with 'git checkout <branch>'"
    fi
    git checkout "$kids"
}

cmd_down() {
    branch=$(current_branch)
    parent=$(parent_of "$branch")
    [ -n "$parent" ] || die "'$branch' has no tracked parent"
    branch_exists "$parent" || die "parent '$parent' no longer exists"
    git checkout "$parent"
}

cmd_bottom() {
    trunk=$(trunk_branch)
    branch=$(current_branch)
    root=$(stack_root "$branch" "$trunk")
    [ "$root" = "$branch" ] && die "'$branch' is already at the bottom of the stack"
    git checkout "$root"
}

cmd_top() {
    branch=$(current_branch)
    while :; do
        kids=$(children_of "$branch")
        count=$(printf '%s' "$kids" | grep -c . || true)
        [ "$count" -eq 1 ] || break
        branch=$kids
    done
    [ "$branch" = "$(current_branch)" ] && die "'$branch' is already at the top of the stack"
    git checkout "$branch"
}

cmd_checkout() {
    trunk=$(trunk_branch)
    current=$(current_branch)
    members=$(stack_members "$current" "$trunk")
    [ -n "$members" ] || die "'$current' is not part of a stack"

    i=0
    for member in $members; do
        i=$((i + 1))
        printf '  %s) %s\n' "$i" "$member"
    done
    printf 'branch number: '
    read -r choice || die "no selection"
    target=$(printf '%s\n' "$members" | sed -n "${choice}p")
    [ -n "$target" ] || die "invalid selection '$choice'"
    git checkout "$target"
}

cmd_push() {
    dry_run=0
    for arg in "$@"; do
        case $arg in
            --dry-run|-n) dry_run=1 ;;
            *) die "usage: $PROGRAM push [--dry-run]" ;;
        esac
    done

    trunk=$(trunk_branch)
    current=$(current_branch)
    members=$(stack_members "$current" "$trunk")
    [ -n "$members" ] || die "'$current' is not part of a stack"

    remote=$(git config --get "branch.$current.remote" || printf 'origin')

    set -- # collect refspecs
    for member in $members; do
        set -- "$@" "$member"
    done

    note "pushing to ${C_CYAN}$remote${C_RESET}: $*"
    if [ "$dry_run" -eq 1 ]; then
        note "${C_DIM}(dry run)${C_RESET}"
        git push --force-with-lease --dry-run "$remote" "$@"
    else
        git push --force-with-lease "$remote" "$@"
    fi
}

usage() {
    # Reprint the header comment block, minus the rule lines and the shebang.
    awk 'NR > 2 && /^# =+$/ { exit } NR > 2 { sub(/^# ?/, ""); print }' "$0"
}

# ------------------------------------------------------------------------------
# Dispatch
# ------------------------------------------------------------------------------

require_repo

subcommand=${1:-list}
[ $# -gt 0 ] && shift

case $subcommand in
    create|branch)      cmd_create "$@" ;;
    track)              cmd_track "$@" ;;
    untrack)            cmd_untrack "$@" ;;
    reparent)           cmd_reparent "$@" ;;
    list|ls|log)        cmd_list 0 ;;
    status|st)          cmd_list 1 ;;
    sync|restack)       cmd_sync "$@" ;;
    up|next)            cmd_up ;;
    down|prev)          cmd_down ;;
    top)                cmd_top ;;
    bottom|base)        cmd_bottom ;;
    checkout|co)        cmd_checkout ;;
    push)               cmd_push "$@" ;;
    help|-h|--help)     usage ;;
    *)                  die "unknown subcommand '$subcommand'; try '$PROGRAM help'" ;;
esac
