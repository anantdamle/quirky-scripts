# super-linter settings, shared by scripts/super-lint (pre-push hook) and
# .github/workflows/lint.yml. Enabling any VALIDATE_* makes super-linter run
# only those linters, so this is the complete list.
#
# Kept in step with the Google-style pre-commit hooks: Black, ESLint and
# Prettier are not enabled because they contradict Pyink and Google JS style,
# and super-linter's clang-format only covers C/C++ (JS/.gs is checked by the
# pre-commit clang-format hook instead).
VALIDATE_BASH=true
VALIDATE_BASH_EXEC=true
VALIDATE_SHELL_SHFMT=true
VALIDATE_PYTHON_PYLINT=true
VALIDATE_MARKDOWN=true
VALIDATE_GITLEAKS=true

# Read rule files from the repository root, the same files pre-commit uses.
LINTER_RULES_PATH=.
PYTHON_PYLINT_CONFIG_FILE=pylintrc
MARKDOWN_CONFIG_FILE=.markdownlint.yaml

DEFAULT_BRANCH=main
IGNORE_GITIGNORED_FILES=true
